<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/ic_checkbox_circle_on.xml
     Círculo verde sólido com check — estado marcado
     O ícone de check (✓) é adicionado via layer-list -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo verde -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#10B981" />
        </shape>
    </item>
    <!-- Check branco centralizado -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:drawable="@drawable/ic_check_white" />
</layer-list>